{
  "manifest_version": 3,
  "name": "詐欺サイトチェッカー",
  "version": "1.4.0",
  "description": "閲覧中のURL・ドメイン・ページ内容からリスク要因を検出し、リスクスコアと判定の根拠を表示します。",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["https://tominarievo.github.io/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["page-analyzer.js", "phishing-analyzer.js", "phishing-dom.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "詐欺サイトチェッカー",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
